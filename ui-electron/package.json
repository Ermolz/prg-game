{
  "name": "dots-and-boxes-ui",
  "version": "1.0.0",
  "private": true,
  "main": "out-electron/main.js",
  "scripts": {
    "check:cli": "node scripts/check-cli.cjs",
    "dev": "npm run check:cli && concurrently -k \"npm run dev:vite\" \"npm run dev:electron\"",
    "dev:vite": "vite",
    "dev:electron": "wait-on http://127.0.0.1:5173 && electron .",
    "electron-only": "electron .",
    "build": "npm run build:vite && npm run build:electron",
    "build:vite": "vite build",
    "build:electron": "tsc -p tsconfig.electron.json",
    "start": "set ELECTRON_LOAD_BUILT=1&& electron .",
    "test:integration": "node scripts/integration-cli.test.mjs",
    "test:integration:java": "node scripts/integration-cli-java.test.mjs",
    "test:integration:python": "node scripts/integration-cli-python.test.mjs",
    "test:integration:prolog": "node scripts/integration-cli-prolog.test.mjs",
    "publish:cli": "node scripts/publish-cli.cjs",
    "dist": "npm run publish:cli && npm run build && electron-builder"
  },
  "dependencies": {
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@vitejs/plugin-react": "^4.2.0",
    "autoprefixer": "^10.4.27",
    "concurrently": "^8.2.2",
    "electron": "^28.3.3",
    "electron-builder": "^24.9.1",
    "postcss": "^8.5.6",
    "tailwindcss": "^3.4.19",
    "typescript": "^5.3.0",
    "vite": "^5.0.0",
    "wait-on": "^7.2.0"
  },
  "build": {
    "appId": "dab.ui",
    "extraResources": [
      {
        "from": "resources/cli",
        "to": "cli"
      }
    ],
    "directories": {
      "output": "release"
    },
    "win": {
      "signAndEditExecutable": false
    }
  }
}
